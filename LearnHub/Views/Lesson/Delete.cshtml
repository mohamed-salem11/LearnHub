@model LearnHub.Domain.Entities.Lesson

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this lesson?</h3>
<div>
    <h4>Lesson Details</h4>
    <hr />
    <dl class="row">
       
        <dt class="col-sm-2">
            Lesson Title
        </dt>
        <dd class="col-sm-10">
            @Model.Title
        </dd>

  
        <dt class="col-sm-2">
            Course Name
        </dt>
        <dd class="col-sm-10">
            @Model.Course?.Title
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-controller="Lesson" asp-action="LessonsByCourse" asp-route-id="@Model.CourseId" class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>








